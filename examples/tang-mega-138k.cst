// Tang Mega 138K (tested in a Tang Console 138K): 50 MHz board clock, the
// user LED V13 (active low), the USB UART of the dock, the two DDR3 chips
// (2x 16 bit, 4Gb each).
IO_LOC "clk"    IOB104B;
IO_PORT "clk" BANK_VCCIO=3.3 PULL_MODE=NONE;
IO_LOC "led" IOB66A; // V13
IO_PORT "led" IO_TYPE=LVCMOS33;
IO_LOC "uart_tx" IOB68A; // U15
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=UP;
// DDR3: 2x 16 bit chips sharing address/command, 1.5V banks. CK and DQS are
// split into separate _n pins, driven as pseudo-differential pairs: they are
// true LVDS pins, where apicula doesn't allow emulated LVDS buffers.
// LVCMOS15 rather than SSTL15: SSTL15 inputs need VREF=INTERNAL, which apicula
// ignores, and it allows only one single ended IO_TYPE per bank.
IO_LOC "ddr_reset_n" IOL55A; // L6
IO_LOC "ddr_cke" IOL38A; // K6
IO_LOC "ddr_cs_n" IOL49B; // P4
IO_LOC "ddr_ras_n" IOL40A; // L5
IO_LOC "ddr_cas_n" IOL40B; // L4
IO_LOC "ddr_we_n" IOL51B; // M5
IO_LOC "ddr_odt" IOL33B; // M2
IO_LOC "ddr_ck" IOL31A; // L3
IO_LOC "ddr_ck_n" IOL31B; // K3
IO_LOC "ddr_ba[0]" IOL49A; // P5
IO_LOC "ddr_ba[1]" IOL47A; // P2
IO_LOC "ddr_ba[2]" IOL51A; // M6
IO_LOC "ddr_addr[0]" IOL35A; // M1
IO_LOC "ddr_addr[1]" IOL22A; // K2
IO_LOC "ddr_addr[2]" IOL17B; // G2
IO_LOC "ddr_addr[3]" IOL29B; // J4
IO_LOC "ddr_addr[4]" IOL22B; // J2
IO_LOC "ddr_addr[5]" IOL17A; // H2
IO_LOC "ddr_addr[6]" IOL26B; // G3
IO_LOC "ddr_addr[7]" IOL15B; // J1
IO_LOC "ddr_addr[8]" IOL20A; // J5
IO_LOC "ddr_addr[9]" IOL20B; // H5
IO_LOC "ddr_addr[10]" IOL35B; // L1
IO_LOC "ddr_addr[11]" IOL26A; // H3
IO_LOC "ddr_addr[12]" IOL29A; // K4
IO_LOC "ddr_addr[13]" IOL15A; // K1
IO_LOC "ddr_addr[14]" IOL4B; // D1
IO_LOC "ddr_dm[0]" IOL78B; // AA4
IO_LOC "ddr_dm[1]" IOL107A; // V7
IO_LOC "ddr_dm[2]" IOL89B; // T6
IO_LOC "ddr_dm[3]" IOL67A; // W1
IO_LOC "ddr_dqs[0]" IOL69A; // Y3
IO_LOC "ddr_dqs_n[0]" IOL69B; // AA3
IO_LOC "ddr_dqs[1]" IOL96A; // V9
IO_LOC "ddr_dqs_n[1]" IOL96B; // V8
IO_LOC "ddr_dqs[2]" IOL94A; // W6
IO_LOC "ddr_dqs_n[2]" IOL94B; // W5
IO_LOC "ddr_dqs[3]" IOL65A; // R3
IO_LOC "ddr_dqs_n[3]" IOL65B; // R2
IO_LOC "ddr_dq[0]" IOL78A; // Y4
IO_LOC "ddr_dq[1]" IOL74A; // AB3
IO_LOC "ddr_dq[2]" IOL76A; // AA5
IO_LOC "ddr_dq[3]" IOL80A; // V4
IO_LOC "ddr_dq[4]" IOL71A; // AA1
IO_LOC "ddr_dq[5]" IOL74B; // AB2
IO_LOC "ddr_dq[6]" IOL76B; // AB5
IO_LOC "ddr_dq[7]" IOL71B; // AB1
IO_LOC "ddr_dq[8]" IOL101A; // AA8
IO_LOC "ddr_dq[9]" IOL103A; // Y8
IO_LOC "ddr_dq[10]" IOL98A; // AB7
IO_LOC "ddr_dq[11]" IOL103B; // Y7
IO_LOC "ddr_dq[12]" IOL101B; // AB8
IO_LOC "ddr_dq[13]" IOL105A; // W9
IO_LOC "ddr_dq[14]" IOL98B; // AB6
IO_LOC "ddr_dq[15]" IOL105B; // Y9
IO_LOC "ddr_dq[16]" IOL85B; // U5
IO_LOC "ddr_dq[17]" IOL89A; // R6
IO_LOC "ddr_dq[18]" IOL87A; // U6
IO_LOC "ddr_dq[19]" IOL83A; // R4
IO_LOC "ddr_dq[20]" IOL92A; // Y6
IO_LOC "ddr_dq[21]" IOL83B; // T4
IO_LOC "ddr_dq[22]" IOL87B; // V5
IO_LOC "ddr_dq[23]" IOL85A; // T5
IO_LOC "ddr_dq[24]" IOL62A; // W2
IO_LOC "ddr_dq[25]" IOL67B; // Y1
IO_LOC "ddr_dq[26]" IOL56A; // T1
IO_LOC "ddr_dq[27]" IOL60A; // U3
IO_LOC "ddr_dq[28]" IOL58A; // U2
IO_LOC "ddr_dq[29]" IOL58B; // V2
IO_LOC "ddr_dq[30]" IOL56B; // U1
IO_LOC "ddr_dq[31]" IOL62B; // Y2
IO_PORT "ddr_reset_n" IO_TYPE=LVCMOS15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_PORT "ddr_cke" IO_TYPE=LVCMOS15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_PORT "ddr_cs_n" IO_TYPE=LVCMOS15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
